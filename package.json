{
  "name": "jlex",
  "version": "1.2.1",
  "description": "A wrapper around jison-lex to make it work as a standalone program like Flex",
  "keywords": [
    "jison-lex",
    "jison",
    "flex"
  ],
  "homepage": "https://github.com/ULL-ESIT-PL/jlex#readme",
  "bugs": {
    "url": "https://github.com/ULL-ESIT-PL/jlex/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ULL-ESIT-PL/jlex.git"
  },
  "license": "ISC",
  "author": "Casiano Rodriguez Leon <crguezl@ull.edu.es> (https://crguezl.github.io/)",
  "type": "commonjs",
  "main": "jlex.js",
  "bin": {
    "jlex": "jlex.js"
  },
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "example": "./jlex.js examples/example.l && node examples/main.js",
    "grammar": "jison examples/grammar.jison -o examples/parser.js",
    "clean": "rm -f examples/example.js examples/parser.js"
  },
  "dependencies": {
    "commander": "^11.0.3",
    "jison": "^0.4.18"
  }
}
